# Replace hostname and certificate paths; validate with nginx -t before loading.
server {
    listen 443 ssl;
    server_name center.example.edu;
    ssl_certificate /etc/ssl/research/fullchain.pem;
    ssl_certificate_key /etc/ssl/research/privkey.pem;
    client_max_body_size 21m;
    location / {
        proxy_pass http://127.0.0.1:8850;
        proxy_set_header Host center.example.edu;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Real-IP "";
    }
}
