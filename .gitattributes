* text=auto

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary

# Frozen RIS encoding/line-ending probes and independent expected-byte digest.
tests/fixtures/ris_independent/*.ris -text whitespace=-blank-at-eol,cr-at-eol
tests/fixtures/ris_independent/expected.json -text whitespace=cr-at-eol

# Public response fixture: retain the acquired bytes and digest on every platform.
tests/fixtures/archive_suggestions/liia-en-20261102.html -text whitespace=-blank-at-eol,cr-at-eol

# Official wheel licenses are hash-locked raw bytes, including native CRLF.
server/licenses/** -text whitespace=-blank-at-eol,cr-at-eol

# Preserve exact generated JS/worker/CSS and upstream license bytes across hosts.
static/vendor/visual/** -text
frontend/prototype-LICENSE.txt -text
